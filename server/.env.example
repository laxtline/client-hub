# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://user:password@localhost:5432/clienthub?schema=public"

# ===== Auth =====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== Groq AI (OpenAI-compatible) =====
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Razorpay (test mode) =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ===== ImageKit.io (client logo uploads) =====
# Get free keys at https://imagekit.io → Developer options → API Keys
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
SMTP_FROM="ClientHub <no-reply@clienthub.app>"
