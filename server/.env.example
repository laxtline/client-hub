# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/clienthub?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_secret
# Access tokens last 15 minutes; refresh cookies last 7 days (authController.js).

# Groq AI (optional - get free key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay test mode (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ImageKit (optional - for logo uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Scheduled jobs (optional)
CRON_TIMEZONE=Asia/Kolkata
