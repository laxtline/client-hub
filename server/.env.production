# ===== Server =====
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app.pages.dev

# ===== Database (PostgreSQL) =====
# Use your production PostgreSQL database URL
DATABASE_URL="postgresql://user:password@host:5432/clienthub?schema=public"

# ===== Auth =====
# IMPORTANT: Generate a strong random secret for production
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ===== Groq AI (OpenAI-compatible) =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Razorpay (production mode) =====
RAZORPAY_KEY_ID=your_production_key
RAZORPAY_KEY_SECRET=your_production_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===== ImageKit.io (client logo uploads) =====
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ClientHub <no-reply@clienthub.app>"
