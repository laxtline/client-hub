{
  "name": "clienthub-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/prisma/seed.js",
    "accounts:setup": "prisma db push && node scripts/setup-accounts.js",
    "test:accounts": "node scripts/verify-accounts.js",
    "prisma:generate": "prisma generate",
